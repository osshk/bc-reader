# Server-side only. Do not prefix with NEXT_PUBLIC.
# In Netlify: Site configuration → Environment variables → GEMINI_API_KEY
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite so a read finishes inside
# Netlify's default 10 second function limit.
# gemini-3.5-flash and gemini-3.8-flash are sharper and often slower.
GEMINI_MODEL=gemini-3.5-flash-lite
